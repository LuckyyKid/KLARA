{
  "expo": {
    "name": "Klara",
    "slug": "klara",
    "version": "1.0.0",
    "scheme": "klara",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klara.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.klara.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44ae52c8-efb7-4023-8ca0-f9f5ddb8a6ae"
      }
    },
    "owner": "tdia-agencyone",
    "runtimeVersion": "exposdk:54.0.0",
    "updates": {
      "url": "https://u.expo.dev/44ae52c8-efb7-4023-8ca0-f9f5ddb8a6ae"
    }
  }
}
